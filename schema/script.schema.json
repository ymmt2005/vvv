{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ymmt2005/vvv/schema/script.schema.json",
  "title": "VVV storyboard (script.json)",
  "description": "Scenes and narration lines of a VVV movie. skills/make-video/references/script-json.md explains every field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "size": {
      "description": "Width and height in pixels; both even, for H.264.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/evenPixels"
        },
        {
          "$ref": "#/$defs/evenPixels"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "fps": {
      "description": "Frames per second.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "captions": {
      "description": "Draw each line's text as a subtitle while it plays.",
      "type": "boolean"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "credits": {
      "description": "Text lines for the closing credits card.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "creditsDuration": {
      "description": "Seconds of the automatic credits card.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "voice": {
      "$ref": "#/$defs/voice"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "evenPixels": {
      "type": "integer",
      "minimum": 2,
      "multipleOf": 2
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "id": {
      "description": "Letters and digits of any script, \"_\", \"-\" and \".\"; ids become file names.",
      "type": "string",
      "pattern": "^[\\p{L}\\p{N}_.-]+$"
    },
    "timing": {
      "description": "Seconds of silence before a scene's first line, between its lines, and after its last line.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead": {
          "$ref": "#/$defs/seconds"
        },
        "gap": {
          "$ref": "#/$defs/seconds"
        },
        "tail": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "lang": {
      "enum": [
        "en",
        "ja",
        "zh",
        "es",
        "fr",
        "pt"
      ]
    },
    "voice": {
      "description": "The voice engine and pronunciation dictionary. skills/make-video/references/voice.md explains them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "piper-plus",
            "google"
          ]
        },
        "model": {
          "description": "piper-plus voice model.",
          "enum": [
            "tsukuyomi"
          ]
        },
        "lengthScale": {
          "description": "piper-plus: above 1 slows every line down.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "noise": {
          "description": "piper-plus: how much the delivery varies.",
          "type": "number",
          "minimum": 0
        },
        "google": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project"
          ],
          "properties": {
            "project": {
              "description": "The GCP project that pays for the requests.",
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "description": "A Chirp 3 HD voice name, such as Charon or Kore.",
              "type": "string",
              "minLength": 1
            },
            "speakingRate": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 2
            }
          }
        },
        "pronounce": {
          "description": "Per language, words and how to speak them: a respelling, or IPA in [[ ]].",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "if": {
        "properties": {
          "engine": {
            "const": "google"
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "required": [
          "google"
        ]
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "chapter": {
          "description": "A one-line chapter title; the scene starts a chapter.",
          "type": "string",
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "duration": {
          "description": "The scene's minimum length in seconds.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transition": {
          "description": "Seconds of crossfade from the previous scene.",
          "$ref": "#/$defs/seconds"
        },
        "lead": {
          "$ref": "#/$defs/seconds"
        },
        "gap": {
          "$ref": "#/$defs/seconds"
        },
        "tail": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "text": {
          "description": "What is spoken, and the subtitle unless caption says otherwise.",
          "type": "string",
          "minLength": 1
        },
        "speech": {
          "description": "Different text to speak.",
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "description": "A different subtitle, or false for none.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": false
            }
          ]
        },
        "who": {
          "description": "The speaker's name, for movie.js.",
          "type": "string"
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pitch": {
              "description": "piper-plus: above 1 raises the voice.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "speed": {
              "description": "piper-plus: above 1 speaks faster.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "name": {
              "description": "google: another Chirp 3 HD voice.",
              "type": "string",
              "minLength": 1
            },
            "speakingRate": {
              "description": "google: another speaking rate.",
              "type": "number",
              "minimum": 0.25,
              "maximum": 2
            }
          }
        }
      }
    }
  }
}
